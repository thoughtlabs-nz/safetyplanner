# Copy to `.env` next to docker-compose.yaml and fill in. `docker compose`
# reads this automatically; nothing here is committed.

# --- Shared ---
# Convex deployment URL. For a local `npx convex dev` on this Mac, use
# http://host.docker.internal:3210 (containers can't see 127.0.0.1).
CONVEX_URL=https://your-deployment.convex.cloud

# --- web (BUILD-time — rebuild the web image after changing these) ---
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# Poller URL as the BROWSER sees it (file/thumbnail links are client-side).
VITE_POLLER_URL=http://localhost:4100
# Host port the web UI is published on.
WEB_PORT=8080

# --- poller ---
POLLER_PORT=4100
POLL_INTERVAL_MS=60000
TIMEOUT_MS=10000

# --- mqtt-ingest ---
MQTT_URL=mqtts://broker.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=mqtt-ingest
MQTT_TOPIC_PREFIX=ddpai
